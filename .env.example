# ==========================================
# FoodLoop Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit '.env' containing sensitive keys to version control.
# ==========================================

# Server Port (Default: 5000)
PORT=5000

# Environment Mode ('development' | 'production' | 'test')
NODE_ENV=development

# Hackathon Demo Mode ('true' | 'false')
# When true: enables demo persona authentication and mock payment simulation.
# Automatically disallowed when NODE_ENV=production.
DEMO_MODE=false

# Allowed CORS Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173,http://127.0.0.1:5000

# MongoDB Connection URI (Local or MongoDB Atlas URI)
# Example local: mongodb://127.0.0.1:27017/foodloop
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/foodloop?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/foodloop

# Google Gemini API Key
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Cascades (comma-separated priority list)
GEMINI_CHAT_MODELS=gemini-2.5-flash,gemini-1.5-flash
GEMINI_VISION_MODELS=gemini-2.5-flash,gemini-1.5-flash

# JWT Secret for Session Authentication
# In production, must be a cryptographically secure string (e.g. openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Test / Live API Keys (Sponsor-A-Meal)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
